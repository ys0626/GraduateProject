  m_Script: {fileID: 11500000, guid: 9f5fdaa72aaf4b04198256c4a8dfd6a4, type: 3}
  m_Name: Abandoned Training Ground
  m_EditorClassIdentifier: Assembly-CSharp::EventData
  eventId: abandoned_training_ground
  eventName: "\uBC84\uB824\uC9C4 \uD6C8\uB828\uC7A5"
  description: "\uC232\uC744 \uBE60\uC838\uB098\uC624\uC790 \uC624\uB798\uB41C \uD6C8\uB828\uC7A5\uC774
    \uB098\uD0C0\uB0AC\uB2E4.\n\n\uB098\uBB34 \uD5C8\uC218\uC544\uBE44\uC640 \uBD80\uC11C\uC9C4
    \uAC80\uB4E4\uC774 \uC5EC\uAE30\uC800\uAE30 \uB110\uB824 \uC788\uC5C8\uC9C0\uB9CC,
    \uD6C8\uB828\uC7A5 \uD55C\uCABD\uC5D0\uB294 \uC544\uC9C1 \uC0AC\uC6A9\uD560 \uC218
    \uC788\uC744 \uAC83 \uAC19\uC740 \uB3C4\uAD6C\uB4E4\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4.\n\n\uBCBD\uC5D0\uB294
    \uB2E4\uC74C\uACFC \uAC19\uC740 \uBB38\uAD6C\uAC00 \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4.\n\n\"\uC218\uB828\uC744
    \uAC8C\uC744\uB9AC\uD558\uC9C0 \uC54A\uB294 \uC790\uB9CC\uC774 \uB354 \uAC15\uD574\uC9C8
    \uC218 \uC788\uB2E4.\""
  background: {fileID: 21300000, guid: d8301bd9e60113e488692736763422f5, type: 3}
  choices:
  - choiceText: "\uACE8\uB4DC\uB97C \uB0B4\uACE0 \uD2B9\uBCC4 \uD6C8\uB828\uC744
      \uBC1B\uB294\uB2E4 (\uACE8\uB4DC 25 \uC18C\uBAA8, \uBB34\uC791\uC704 \uCE74\uB4DC
      \uAC15\uD654)"
    resultDescription: "\uC624\uB798\uB41C \uD6C8\uB828\uBC95\uC744 \uC775\uD788\uBA70
      \uC790\uC2E0\uC758 \uAE30\uC220\uC744 \uD55C\uCE35 \uB354 \uBC1C\uC804\uC2DC\uCF30\uB2E4."
    conditions:
    - conditionType: 2
      requiredValue: 25
    - conditionType: 5
      requiredValue: 0
    effects:
    - effectType: 2
      amount: 25
    - effectType: 9
      amount: 0
  - choiceText: "\uD63C\uC790 \uAC00\uBCCD\uAC8C \uD6C8\uB828\uD55C\uB2E4 (\uCCB4\uB825
      8 \uD68C\uBCF5)"
    resultDescription: "\uAC00\uBCCD\uAC8C \uBAB8\uC744 \uD480\uACE0 \uB098\uB2C8
      \uAE34 \uC5EC\uC815\uC73C\uB85C \uC313\uC778 \uD53C\uB85C\uAC00 \uC870\uAE08
      \uC0AC\uB77C\uC84C\uB2E4."
    conditions: []
    effects:
    - effectType: 3
      amount: 8
