  eventName: "\uC810\uC561\uC73C\uB85C \uB4A4\uB36E\uC778 \uBCF4\uBB3C \uCC3D\uACE0"
  description: "\uC624\uB798\uB41C \uCC3D\uACE0\uC5D0 \uB4E4\uC5B4\uC130\uB2E4. \uBC14\uB2E5\uACFC
    \uBCBD\uC5D0\uB294 \uC815\uCCB4\uB97C \uC54C \uC218 \uC5C6\uB294 \uB048\uC801\uD55C
    \uC810\uC561\uC774 \uAC00\uB4DD\uD558\uB2E4. \uADF8 \uC544\uB798\uB85C \uC218\uB9CE\uC740
    \uAE08\uD654\uAC00 \uBC18\uC9DD\uC774\uACE0 \uC788\uB2E4. \uAE4A\uC219\uD55C
    \uACF3\uC5D0\uB294 \uB354 \uB9CE\uC740 \uBCF4\uBB3C\uC774 \uC788\uB294 \uAC83
    \uAC19\uC9C0\uB9CC, \uC810\uC561\uC758 \uC6C0\uC9C1\uC784\uC774 \uC2EC\uC0C1\uCE58
    \uC54A\uB2E4."
  background: {fileID: 21300000, guid: 7cfc554bc88da7046935c478018c14a4, type: 3}
  choices:
  - choiceText: "\uC810\uC561 \uC18D \uAE4A\uC219\uD55C \uACF3\uAE4C\uC9C0 \uC190\uC744
      \uB123\uB294\uB2E4 (\uCCB4\uB825 9 \uC18C\uBAA8, \uACE8\uB4DC 70 \uD68D\uB4DD)"
    resultDescription: "\uB048\uC801\uD55C \uC810\uC561\uC774 \uD314\uC744 \uD718\uAC10\uC558\uC9C0\uB9CC,
      \uAC04\uC2E0\uD788 \uAE4A\uC219\uD55C \uACF3\uC5D0 \uBB3B\uD600 \uC788\uB358
      \uAE08\uD654 \uC8FC\uBA38\uB2C8\uB97C \uAEBC\uB0C8\uB2E4. \uAF64 \uBB35\uC9C1\uD558\uB2E4!"
    conditions:
    - conditionType: 1
      requiredValue: 10
    effects:
    - effectType: 4
      amount: 9
    - effectType: 1
      amount: 70
  - choiceText: "\uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C4 \uAE08\uD654\uB9CC \uCC59\uAE34\uB2E4
      (\uACE8\uB4DC 25 \uD68D\uB4DD)"
    resultDescription: "\uC810\uC561\uC5D0 \uC190\uC744 \uB2F4\uADF8\uB294 \uAC83\uC740
      \uC704\uD5D8\uD574 \uBCF4\uC778\uB2E4. \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC838
      \uC788\uB358 \uAE08\uD654 \uBA87 \uAC1C\uB9CC \uC8FC\uC6CC\uC11C \uCC3D\uACE0\uB97C
      \uBE60\uC838\uB098\uC654\uB2E4."
