  m_Script: {fileID: 11500000, guid: 9f5fdaa72aaf4b04198256c4a8dfd6a4, type: 3}
  m_Name: Ancient Guardian Shrine
  m_EditorClassIdentifier: Assembly-CSharp::EventData
  eventId: ancient_guardian_shrine
  eventName: "\uB0A1\uC740 \uC218\uD638\uC790\uC758 \uC81C\uB2E8"
  description: "\uC624\uB798\uB41C \uB3CC\uACC4\uB2E8\uC744 \uB530\uB77C \uC62C\uB77C\uAC00\uC790
    \uC774\uB07C\uB85C \uB4A4\uB36E\uC778 \uC791\uC740 \uC81C\uB2E8\uC774 \uBAA8\uC2B5\uC744
    \uB4DC\uB7EC\uB0C8\uB2E4.\n\n\uC81C\uB2E8 \uD55C\uAC00\uC6B4\uB370\uC5D0\uB294
    \uD76C\uBBF8\uD558\uAC8C \uBE5B\uB098\uB294 \uBB38\uC591\uC774 \uC0C8\uACA8\uC838
    \uC788\uC5C8\uACE0, \uC8FC\uBCC0\uC5D0\uB294 \uC624\uB798\uB41C \uBB34\uAE30\uC640
    \uAC11\uC637\uC758 \uD754\uC801\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4.\n\n\uBB38\uC591
    \uC544\uB798\uC5D0\uB294 \uC791\uC740 \uAE00\uC528\uAC00 \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4.\n\n\"\uC218\uD638\uC790\uC758
    \uD798\uC744 \uC6D0\uD558\uB294 \uC790\uC5EC, \uADF8\uC5D0 \uAC78\uB9DE\uC740
    \uB300\uAC00\uB97C \uBC14\uCCD0\uB77C.\""
  background: {fileID: 21300000, guid: 26c435148ae707a4d8e522d27756487e, type: 3}
  choices:
  - choiceText: "\uB300\uAC00\uB97C \uBC14\uCE58\uACE0 \uC81C\uB2E8\uC758 \uD798\uC744
      \uC5BB\uB294\uB2E4 (\uCCB4\uB825 15 \uC18C\uBAA8, \uBB34\uC791\uC704 \uC720\uBB3C
      \uD68D\uB4DD)"
    resultDescription: "\uC81C\uB2E8\uC5D0 \uD53C\uAC00 \uC2A4\uBA70\uB4E4\uC790
      \uD76C\uBBF8\uD55C \uBE5B\uC774 \uAC15\uD558\uAC8C \uD0C0\uC62C\uB790\uB2E4.
      \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uC720\uBB3C \uD558\uB098\uAC00 \uBAA8\uC2B5\uC744
      \uB4DC\uB7EC\uB0C8\uB2E4."
    conditions:
    - conditionType: 1
      requiredValue: 16
    effects:
    - effectType: 4
      amount: 15
    - effectType: 6
      amount: 0
  - choiceText: "\uC81C\uB2E8\uC5D0 \uC870\uC6A9\uD788 \uAE30\uB3C4\uD55C\uB2E4 (\uCCB4\uB825
      5 \uD68C\uBCF5)"
    resultDescription: "\uC7A0\uC2DC \uAE30\uB3C4\uB97C \uC62C\uB9AC\uC790 \uB9C8\uC74C\uC774
      \uCC28\uBD84\uD574\uC9C0\uACE0 \uBAB8\uC758 \uD53C\uB85C\uAC00 \uC870\uAE08
      \uAC00\uC168\uB2E4."
    conditions: []
    effects:
    - effectType: 3
      amount: 5
