  eventId: lost_herbalist
  eventName: "\uAE38 \uC783\uC740 \uC57D\uCD08\uAFBC"
  description: "\uC232\uC18D \uAE4A\uC740 \uACF3\uC5D0\uC11C \uC791\uC740 \uC0DD\uC950
    \uD55C \uB9C8\uB9AC\uAC00 \uC57D\uCD08 \uBC14\uAD6C\uB2C8\uB97C \uB4A4\uC801\uC774\uACE0
    \uC788\uC5C8\uB2E4. \uC0DD\uC950\uB294 \uB2F9\uC2E0\uC744 \uBC1C\uACAC\uD558\uC790
    \uBC18\uAC00\uC6B4 \uD45C\uC815\uC73C\uB85C \uB2E4\uAC00\uC654\uB2E4.\n\n\"\uD639\uC2DC
    \uB9C8\uC744\uB85C \uAC00\uB294 \uAE38\uC744 \uC544\uC2DC\uB098\uC694? \uBA70\uCE60\uC9F8
    \uC774 \uC232\uC744 \uD5E4\uB9E4\uACE0 \uC788\uC5B4\uC694. \uAE38\uC744 \uC54C\uB824\uC8FC\uC2E0\uB2E4\uBA74
    \uC81C\uAC00 \uBAA8\uC740 \uC57D\uCD08\uB97C \uB098\uB204\uC5B4 \uB4DC\uB9B4\uAC8C\uC694!\""
  background: {fileID: 21300000, guid: f338579bc30944247b4390e76c2bcb2a, type: 3}
  choices:
  - choiceText: "\uACE8\uB4DC\uB97C \uC8FC\uACE0 \uC57D\uCD08\uB97C \uBC1B\uB294\uB2E4
      (\uACE8\uB4DC 20 \uC18C\uBAA8, \uCCB4\uB825 25 \uD68C\uBCF5)"
    resultDescription: "\uC57D\uCD08\uAFBC\uC740 \uACE0\uB9D9\uB2E4\uB294 \uC778\uC0AC\uB97C
      \uAC74\uB124\uBA70 \uC815\uC131\uAECF \uB9D0\uB9B0 \uC57D\uCD08\uB97C \uAC74\uB124\uC8FC\uC5C8\uB2E4."
    conditions:
    - conditionType: 2
      requiredValue: 20
    effects:
    - effectType: 2
      amount: 20
    - effectType: 3
      amount: 25
  - choiceText: "\uC57D\uCD08 \uCC44\uC9D1\uC744 \uB3C4\uC640\uC8FC\uACE0 \uBCF4\uC218\uB97C
      \uBC1B\uB294\uB2E4 (\uACE8\uB4DC 10 \uD68D\uB4DD)"
    resultDescription: "\uC57D\uCD08\uAFBC\uACFC \uD568\uAED8 \uC57D\uCD08\uB97C
      \uCC44\uC9D1\uD55C \uB4A4 \uC18C\uC18C\uD55C \uBCF4\uC218\uB97C \uBC1B\uC558\uB2E4."
