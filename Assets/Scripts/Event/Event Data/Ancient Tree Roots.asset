  m_Script: {fileID: 11500000, guid: 9f5fdaa72aaf4b04198256c4a8dfd6a4, type: 3}
  m_Name: Ancient Tree Roots
  m_EditorClassIdentifier: Assembly-CSharp::EventData
  eventId: ancient_tree_roots
  eventName: "\uACE0\uB300 \uB098\uBB34\uC758 \uBFCC\uB9AC"
  description: "\uC232\uC758 \uC911\uC2EC\uC5D0 \uB3C4\uCC29\uD558\uC790 \uD558\uB298\uC744
    \uAC00\uB9B4 \uB9CC\uD07C \uAC70\uB300\uD55C \uB098\uBB34\uAC00 \uB098\uD0C0\uB0AC\uB2E4.\n\n\uB098\uBB34\uC758
    \uBFCC\uB9AC\uB294 \uB545 \uC704\uB85C \uC19F\uC544\uC62C\uB77C \uC788\uC5C8\uACE0,
    \uADF8 \uC0AC\uC774\uC5D0\uC11C\uB294 \uB530\uB73B\uD55C \uD669\uAE08\uBE5B\uC774
    \uC0C8\uC5B4 \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4.\n\n\uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uC790
    \uBAB8\uC18D \uAE4A\uC740 \uACF3\uC5D0\uC11C\uBD80\uD130 \uC54C \uC218 \uC5C6\uB294
    \uC0DD\uBA85\uB825\uC774 \uB290\uAEF4\uC84C\uB2E4. \uD558\uC9C0\uB9CC \uADF8
    \uD798\uC744 \uC628\uC804\uD788 \uBC1B\uC544\uB4E4\uC774\uB824\uBA74 \uC0C1\uB2F9\uD55C
    \uACE0\uD1B5\uC744 \uAC10\uC218\uD574\uC57C \uD560 \uAC83 \uAC19\uB2E4."
  background: {fileID: 21300000, guid: dfb8810a1c525de45af52e3a559b6628, type: 3}
  choices:
  - choiceText: "\uBFCC\uB9AC\uC758 \uD798\uC744 \uBC1B\uC544\uB4E4\uC778\uB2E4 (\uCCB4\uB825
      10 \uC18C\uBAA8, \uCD5C\uB300 \uCCB4\uB825 10 \uC99D\uAC00)"
    resultDescription: "\uAC15\uB82C\uD55C \uC0DD\uBA85\uB825\uC774 \uBAB8\uC18D\uC73C\uB85C
      \uD758\uB7EC\uB4E4\uC5C8\uB2E4. \uACE0\uD1B5\uC740 \uC0C1\uB2F9\uD588\uC9C0\uB9CC
      \uBAB8\uC740 \uC774\uC804\uBCF4\uB2E4 \uD2BC\uD2BC\uD574\uC84C\uB2E4."
    conditions:
    - conditionType: 1
      requiredValue: 11
    effects:
    - effectType: 4
      amount: 10
    - effectType: 5
      amount: 10
  - choiceText: "\uB098\uBB34\uC758 \uC5F4\uB9E4\uB97C \uCC59\uAE34\uB2E4 (\uACE8\uB4DC
      20 \uD68D\uB4DD)"
    resultDescription: "\uB098\uBB34 \uC544\uB798 \uB5A8\uC5B4\uC9C4 \uC2E0\uBE44\uB85C\uC6B4
      \uC5F4\uB9E4\uB97C \uBA87 \uAC1C \uCC59\uACA8 \uC0C1\uC778\uC5D0\uAC8C \uD314\uAE30\uB85C
      \uD588\uB2E4."
    conditions: []
    effects:
    - effectType: 1
      amount: 20
